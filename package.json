{
  "name": "zakkdev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4200",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:embeddings": "tsx scripts/build-post-embeddings.ts",
    "add-summaries": "tsx scripts/add-summaries.ts",
    "add-summaries:force": "tsx scripts/add-summaries.ts --force",
    "add-summaries:gpt4": "tsx scripts/add-summaries.ts --model gpt-4o-mini",
    "diagrams": "bash scripts/generate-diagrams.sh",
    "test:finance": "node --conditions=react-server --import tsx --test tests/finance/auth.test.ts tests/finance/password-hash.test.ts tests/finance/bot-avatar-art.test.ts tests/finance/bot-template-meta.test.ts tests/finance/merge-bot-messages.test.ts tests/finance/structured-response.test.ts tests/finance/worker-report-data.test.ts tests/finance/infra.test.ts tests/finance/credentials.test.ts tests/finance/cost.test.ts tests/finance/agent.test.ts tests/finance/data.test.ts tests/finance/routine.test.ts tests/finance/scheduler.test.ts tests/finance/worker.test.ts tests/finance/worker-infra.test.ts",
    "test:finance:integration": "node --conditions=react-server --import tsx --test tests/finance/rate-limit.integration.test.ts tests/finance/budget.integration.test.ts tests/finance/agent.integration.test.ts tests/finance/thesis.integration.test.ts tests/finance/demo-scenario.integration.test.ts tests/finance/worker.integration.test.ts",
    "test:finance:e2e": "tsx tests/finance/auth.e2e.ts",
    "test:site:e2e": "tsx tests/site/site-portals.e2e.playwright.ts",
    "finance:credentials": "tsx scripts/finance-credentials.ts",
    "infra:finance-auth": "cdk --app \"node_modules/.bin/tsx infra/finance-auth.ts\" --output /tmp/zakkdev-finance-cdk.out",
    "infra:finance-budget": "cdk --app \"node_modules/.bin/tsx infra/finance-budget.ts\" --output /tmp/zakkdev-finance-budget-cdk.out",
    "infra:finance-worker": "cdk --app \"node_modules/.bin/tsx infra/finance-worker.ts\" --output /tmp/zakkdev-finance-worker-cdk.out"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/client-scheduler": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@giscus/react": "^3.1.0",
    "@mantine/core": "^8.2.5",
    "@mantine/hooks": "^8.2.5",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.3",
    "@node-rs/argon2": "^2.2.2",
    "@react-three/drei": "^10.7.2",
    "@react-three/fiber": "^9.3.0",
    "@react-three/rapier": "^2.1.0",
    "@tabler/icons-react": "^3.1.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.2.2",
    "@vercel/speed-insights": "^1.0.10",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.12",
    "meshline": "^3.3.0",
    "next": "15.4.8",
    "openai": "^6.8.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "8.5.9",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "three": "^0.179.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@types/navermaps": "^3.7.5",
    "@types/node": "^20",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/three": "^0.179.0",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "15.4.6",
    "playwright": "1.52.0",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.13.0",
    "postcss-simple-vars": "^7.0.1",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
