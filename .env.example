# Copy to .env.local and fill locally. Never commit .env.local.
# Generate the two secret values with pnpm finance:credentials (see docs/finance-auth.md).
FINANCE_PASSWORD_HASH=
FINANCE_SESSION_SECRET=
FINANCE_APP_ORIGIN=http://localhost:4200
FINANCE_AUTH_TABLE=finance-auth-local
AWS_REGION=ap-northeast-2
# Development only. Omit this variable on Vercel/production.
FINANCE_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
